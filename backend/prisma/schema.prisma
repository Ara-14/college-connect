datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  fullName        String
  passwordHash    String
  collegeId       String?
  collegeName     String?
  department      String?
  semester        String?   // e.g. "3rd Sem", "5th Sem"
  section         String?   // e.g. "Section A", "Section B"
  yearOfStudy     String?
  rollNumber      String?   // USN or Faculty Employee ID
  bio             String?   @db.Text
  avatarUrl       String?
  role            String    @default("STUDENT") // STUDENT, FACULTY, ADMIN
  isVerified      Boolean   @default(false)
  allowStudentDMs Boolean   @default(true) // Faculty can disable incoming student DMs
  status          String    @default("ONLINE") // ONLINE, AWAY, OFFLINE
  officeHours     String?   // For faculty (e.g., "Mon-Wed 2-4 PM")
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  college         College?  @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  // Social & Posts
  posts           Post[]
  likes           Like[]
  comments        Comment[]
  savedPosts      SavedPost[]
  stories         Story[]

  // Academic Resources (Teacher uploads)
  uploadedResources AcademicResource[]

  // Follow graph
  followers       Follow[]  @relation("UserFollowers")
  following       Follow[]  @relation("UserFollowing")

  // Messaging & Conversations
  conversations         ConversationMember[]
  createdConversations  Conversation[]       @relation("ConversationCreator")
  messagesSent          Message[]
  messageReadReceipts   MessageReadReceipt[]
  messageReports        MessageReport[]
  moderationActions     MessageModerationAction[] @relation("ModerationActor")
  moderatedTargets      MessageModerationAction[] @relation("ModerationTarget")
  appeals               MessageAppeal[] @relation("AppealUser")
  reviewedAppeals       MessageAppeal[] @relation("AppealReviewer")
  auditActions          AccessAuditLog[] @relation("AuditActor")
  auditedSubjects       AccessAuditLog[] @relation("AuditSubject")
  blockedUsers          UserBlock[]          @relation("UserBlocker")
  blockedByUsers        UserBlock[]          @relation("UserBlocked")

  // Communities
  createdCommunities    Community[]          @relation("CommunityCreator")
  communityMemberships  CommunityMember[]
  channelMessages       ChannelMessage[]

  // Notifications
  notificationsReceived Notification[]       @relation("UserNotificationsReceived")
  notificationsSent     Notification[]       @relation("UserNotificationsSent")

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([department])
}

model College {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String?  @unique
  location  String?
  createdAt DateTime @default(now())

  users     User[]
}

model Post {
  id        String      @id @default(uuid())
  userId    String
  caption   String?     @db.Text
  location  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     PostMedia[]
  likes     Like[]
  comments  Comment[]
  savedBy   SavedPost[]

  @@index([userId])
  @@index([createdAt])
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  mediaUrl  String
  mediaType String   @default("IMAGE") // IMAGE, VIDEO
  position  Int      @default(0)

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model Story {
  id        String   @id @default(uuid())
  userId    String
  mediaUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// COMMUNICATION MODULE SCHEMAS
// ==========================================

model Conversation {
  id              String               @id @default(uuid())
  title           String?              // Group name or Subject for academic query
  description     String?              @db.Text
  type            String               @default("DIRECT") // DIRECT, GROUP, ANNOUNCEMENT, QUERY
  avatarUrl       String?
  createdById     String?
  department      String?              // For department groups
  semester        String?              // For class/semester groups
  section         String?              // For section groups
  subject         String?              // For course/subject study groups or queries
  isFacultyOnly   Boolean              @default(false)
  isReadOnly      Boolean              @default(false) // e.g. Announcement channels
  pinnedMessageId String?
  freeToTalkKey   String?              @unique
  messageRateLimitSeconds Int           @default(3)
  reportReviewHours Int                @default(48)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  creator         User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members         ConversationMember[]
  messages        Message[]
  pinnedMessage   Message?             @relation("PinnedConversationMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([department])
  @@index([createdById])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER") // ADMIN, MEMBER
  isMuted        Boolean      @default(false)
  isArchived     Boolean      @default(false)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())
  acceptedPolicyVersion String?
  messagingRestrictedUntil DateTime?
  lastMessageAt  DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id                  String               @id @default(uuid())
  conversationId      String
  senderId            String
  content             String               @db.Text
  messageType         String               @default("TEXT") // TEXT, FILE, IMAGE, ANNOUNCEMENT, SYSTEM
  tags                String[]             @default([])
  replyToId           String?
  isEdited            Boolean              @default(false)
  isPinned            Boolean              @default(false)
  isDeleted           Boolean              @default(false)
  isHidden            Boolean              @default(false)
  queryCategory       String?              // "Assignment Help", "Project Guidance", "Exam Query", "General"
  isRead              Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  conversation        Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo             Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies             Message[]            @relation("MessageReplies")
  attachments         MessageAttachment[]
  readReceipts        MessageReadReceipt[]
  reports             MessageReport[]
  moderationActions   MessageModerationAction[]
  pinnedInConversations Conversation[]     @relation("PinnedConversationMessage")

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@index([createdAt])
  @@index([tags], type: Gin)
}

model MessageAttachment {
  id          String   @id @default(uuid())
  messageId   String
  fileName    String
  fileUrl     String
  fileType    String   @default("FILE") // PDF, IMAGE, DOC, OTHER
  fileSize    String?
  mimeType    String?
  createdAt   DateTime @default(now())

  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageReport {
  id           String   @id @default(uuid())
  messageId    String
  reportedById String
  category     String   @default("INAPPROPRIATE_CONTENT")
  reason       String   @db.Text
  status       String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedBy   User     @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@unique([messageId, reportedById])
  @@index([messageId])
  @@index([reportedById])
  @@index([status, createdAt])
}

model MessageModerationAction {
  id               String   @id @default(uuid())
  messageId        String
  actorId          String
  targetUserId     String?
  action           String
  reason           String   @db.Text
  restrictionUntil DateTime?
  createdAt        DateTime @default(now())

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actor      User     @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User?    @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  appeals    MessageAppeal[]

  @@index([messageId, createdAt])
  @@index([targetUserId, createdAt])
}

model MessageAppeal {
  id           String   @id @default(uuid())
  actionId     String
  userId       String
  reason       String   @db.Text
  status       String   @default("PENDING")
  response     String?  @db.Text
  reviewedById String?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  action     MessageModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user       User     @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([actionId, userId])
}

model AccessAuditLog {
  id        String   @id @default(uuid())
  actorId   String
  subjectId String?
  action    String
  reason    String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  actor   User  @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  subject User? @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([action, createdAt])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ==========================================
// COMMUNITIES & NOTIFICATIONS & ACADEMICS
// ==========================================

model Community {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?           @db.Text
  avatarUrl   String?
  createdById String
  createdAt   DateTime          @default(now())

  creator     User              @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     CommunityMember[]
  channels    Channel[]
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  userId      String
  role        String    @default("MEMBER") // OWNER, ADMIN, MODERATOR, MEMBER
  joinedAt    DateTime  @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model Channel {
  id          String           @id @default(uuid())
  communityId String
  name        String
  description String?
  createdAt   DateTime         @default(now())

  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages    ChannelMessage[]

  @@unique([communityId, name])
  @@index([communityId])
}

model ChannelMessage {
  id        String   @id @default(uuid())
  channelId String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  actorId     String?
  type        String   // LIKE, COMMENT, FOLLOW, MESSAGE, REPLY, GROUP_INVITE, ANNOUNCEMENT, ACADEMIC_UPDATE
  title       String?
  message     String
  entityId    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   User     @relation("UserNotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?    @relation("UserNotificationsSent", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([isRead])
}

model Subject {
  id          String             @id @default(uuid())
  code        String             @unique // e.g. 21CS32
  name        String             // e.g. Data Structures & Algorithms
  department  String
  semester    String             // e.g. 3rd Sem
  resources   AcademicResource[]
  createdAt   DateTime           @default(now())

  @@index([code])
}

model AcademicResource {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  category    String   // NOTES, QUESTION_PAPER, LAB_MANUAL, SYLLABUS
  fileUrl     String
  fileFormat  String   @default("PDF")
  fileSize    String?
  subjectId   String
  uploaderId  String
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([uploaderId])
  @@index([category])
}
