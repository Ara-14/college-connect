# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# When running locally on host machine:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collegeconnect?schema=public"
# When running inside Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/collegeconnect?schema=public"

# Authentication Secrets
JWT_SECRET=collegeconnect_development_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Local File Uploads Directory
UPLOAD_DIR=uploads
